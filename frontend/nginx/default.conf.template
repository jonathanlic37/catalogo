# frontend/nginx/default.conf.template
server_tokens off;

# Origen del IdP para la CSP (security-headers.conf). Se inyecta desde OIDC_ORIGIN al arrancar, así
# cambiar KEYCLOAK_PORT/issuer no exige reconstruir la imagen.
map $host $oidc_origin {
    default "${OIDC_ORIGIN}";
}

# Límite de peticiones por IP hacia la API (mitiga abuso/DoS básico). Ajustable por entorno.
limit_req_zone $binary_remote_addr zone=api:10m rate=${RATE_LIMIT_RATE};
limit_req_status 429;

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/css application/javascript application/json application/problem+json image/svg+xml;

server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;

    # Las peticiones de la UI son JSON pequeño: se limita el cuerpo para no reenviar basura al Consumer.
    client_max_body_size 64k;

    include /etc/nginx/snippets/security-headers.conf;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # El Authorization lo aporta el navegador: el SPA obtiene un JWT del IdP (OIDC + PKCE) y lo envía;
    # nginx solo lo reenvía. Ningún token se incluye en el bundle JS.
    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        limit_req zone=api burst=${RATE_LIMIT_BURST} nodelay;
        add_header Cache-Control "no-store" always;
        # El Consumer (Spring Security) ya envía estas cabeceras: se descartan para no duplicarlas.
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Cache-Control;
        proxy_pass ${CONSUMER_UPSTREAM}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }

    # Los assets llevan hash en el nombre: se pueden cachear "para siempre".
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
