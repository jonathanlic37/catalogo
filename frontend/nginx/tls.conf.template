# frontend/nginx/tls.conf.template — terminación TLS (solo con docker-compose.tls.yml, que monta
# este fichero y el certificado). Descifra en 8443 y reenvía al servidor HTTP interno (8080) del
# mismo contenedor, que conserva CSP, cabeceras, límite de peticiones y proxy a la API: una sola
# configuración de la aplicación para los dos modos.
server {
    listen 8443 ssl;
    http2 on;

    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    client_max_body_size 64k;

    # HSTS configurable: en localhost se deja en 0, porque el navegador lo aplicaría a todo
    # «localhost» (también al IdP en http://localhost:8095). Con un dominio real: 31536000.
    add_header Strict-Transport-Security "max-age=${HSTS_MAX_AGE}" always;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # La IP real del cliente llega al servidor interno (real_ip) para el límite de peticiones.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 3s;
        proxy_read_timeout 35s;
    }
}
