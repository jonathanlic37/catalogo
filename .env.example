# .env.example — copiar a .env y sustituir los tokens antes de levantar el entorno.
# docker compose lee este archivo automáticamente para interpolar docker-compose.yml.
# Protege el .env: chmod 600 .env (contiene secretos y está en .gitignore).

# Puertos publicados en el host.
FRONTEND_PORT=8088
CONSUMER_PORT=8081
PRODUCER_PORT=8082

# Interfaz donde escucha la UI. La UI no tiene login de usuario, así que por defecto solo es
# accesible desde esta máquina. Usa 0.0.0.0 únicamente detrás de un proxy con TLS y autenticación.
FRONTEND_BIND=127.0.0.1

# Tokens Bearer entre servicios. Las APIs NO arrancan si tienen menos de 32 caracteres o
# conservan el texto "cambiar". Genera cada uno con:  openssl rand -hex 32
CONSUMER_TO_PRODUCER_TOKEN=cambiar-token-consumer-a-producer-0000000000000000
FRONTEND_TO_CONSUMER_TOKEN=cambiar-token-frontend-a-consumer-0000000000000000

# Orígenes permitidos por CORS (separados por comas).
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:5173

# Reintentos de sincronización del Consumer hacia el Producer.
SYNC_MAX_RETRIES=5
SYNC_RETRY_INTERVAL_MS=10000

# Política ante conflicto de versión (409): MANUAL (usuario decide), PRODUCER_WINS o CONSUMER_WINS.
SYNC_CONFLICT_POLICY=MANUAL

# Copias de seguridad de la base de datos del Producer (fuente de verdad), en el volumen producer-backups.
BACKUP_ENABLED=true
BACKUP_INTERVAL_MS=21600000
BACKUP_KEEP=8

# URL base que usa el bundle del frontend (relativa: pasa por el proxy nginx).
VITE_API_URL=/api

# Límite de peticiones por IP hacia la API en el proxy nginx (limit_req).
RATE_LIMIT_RATE=20r/s
RATE_LIMIT_BURST=40

# Retención de eventos SENT del outbox del Consumer (días).
SYNC_OUTBOX_RETENTION_DAYS=7
