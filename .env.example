# .env.example — configuración de ejemplo. Arranque local en limpio:
#
#   cp .env.example .env
#   docker compose up --build
#
# Los valores marcados "dev-only" NO son secretos reales: sirven solo para levantar el entorno
# local sin pasos extra. Las APIs los aceptan pero lo advierten en el log. Fuera de un entorno
# local sustitúyelos (p. ej. `openssl rand -hex 32`) y protege el fichero: chmod 600 .env.
# `.env` está en .gitignore: nunca se versiona.

# --- Puertos publicados en el host (todos solo en 127.0.0.1 salvo FRONTEND_BIND) ---
FRONTEND_PORT=8088
CONSUMER_PORT=8081
PRODUCER_PORT=8082
KEYCLOAK_PORT=8095

# Interfaz donde escucha la UI. Por defecto solo esta máquina; usa 0.0.0.0 únicamente detrás de un
# proxy con TLS (y ajusta OIDC_ISSUER / OIDC_REDIRECT_URI / CORS al nombre público).
FRONTEND_BIND=127.0.0.1

# --- Credenciales de la Producer API (Bearer tokens estáticos, mínimo privilegio) ---
# Las APIs NO arrancan si un token tiene menos de 32 caracteres, contiene el marcador "cambiar" o si
# ambos son iguales. Genera cada uno con: openssl rand -hex 32
# Consumer → Producer: SOLO webhook y lectura (reconciliación). Lo conocen Producer y Consumer.
CONSUMER_TO_PRODUCER_TOKEN=dev-only-consumer-to-producer-token-for-local-use-0001
# Administración de la aplicación central: escritura directa en la fuente de verdad (+ lectura y
# métricas). Solo lo conoce el Producer; el Consumer no lo recibe.
PRODUCER_ADMIN_TOKEN=dev-only-producer-admin-token-for-local-use-0001

# --- Autenticación de usuarios: proveedor de identidad OIDC (Keycloak) ---
# Credenciales de la consola de administración de Keycloak (http://localhost:8095).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev-only-keycloak-admin-password
# Contraseñas de los usuarios de demostración del realm (usuario `demo` con rol user; `admin` con
# roles user+admin). El realm versionado no contiene contraseñas: se inyectan desde aquí al importar.
DEMO_USER_PASSWORD=demo-dev-only
DEMO_ADMIN_PASSWORD=admin-dev-only
# `OIDC_ISSUER` es el público (lo ve el navegador y va en el claim `iss` del JWT);
# `OIDC_JWK_SET_URI` es el interno (lo alcanza el contenedor del Consumer para validar la firma).
OIDC_ISSUER=http://localhost:8095/realms/catalogo
OIDC_JWK_SET_URI=http://auth:8080/realms/catalogo/protocol/openid-connect/certs
OIDC_CLIENT_ID=catalogo-ui
OIDC_REDIRECT_URI=http://localhost:8088/callback

# --- CORS (orígenes permitidos, separados por comas) ---
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:5173

# --- Sincronización Consumer → Producer ---
SYNC_MAX_RETRIES=5
SYNC_RETRY_INTERVAL_MS=10000
# Reconciliación automática con el Producer (además del botón «Sincronizar ahora»).
SYNC_RECONCILE_INTERVAL_MS=60000
# Política ante conflicto de versión (409): MANUAL (el usuario decide), PRODUCER_WINS o CONSUMER_WINS.
SYNC_CONFLICT_POLICY=MANUAL
# Retención de eventos SENT del outbox (días); los FAILED se conservan para reintento/auditoría.
SYNC_OUTBOX_RETENTION_DAYS=7

# --- Producer: retención de idempotencia y copias de seguridad de la fuente de verdad ---
IDEMPOTENCY_RETENTION_DAYS=7
BACKUP_ENABLED=true
BACKUP_INTERVAL_MS=21600000
BACKUP_KEEP=8

# --- Frontend ---
# URL base del bundle (relativa: pasa por el proxy nginx). Solo configuración pública, nunca tokens.
VITE_API_URL=/api
# Límite de peticiones por IP hacia la API en el proxy nginx (limit_req → 429).
RATE_LIMIT_RATE=20r/s
RATE_LIMIT_BURST=40
